terraform.rc

# Local plan files
*.tfplan
tfplan
plan.out

# Environment variable files
.env
.env.*

# IDE files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Private keys
*.pem
*.pfx
*.key